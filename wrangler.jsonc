{
  // "name" muss genau so heißen wie dein Worker in Cloudflare
  "name": "wishly",
  "main": "worker.js",
  "compatibility_date": "2025-09-01",
  // erreichbar unter wishly.<konto>.workers.dev und dnoadrian.at/wishly
  "workers_dev": true,
  "routes": [{ "pattern": "dnoadrian.at/wishly*", "zone_name": "dnoadrian.at" }],
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },
  // Speicher für Benutzerkonten und Wunschlisten (wird beim Deploy automatisch angelegt)
  "durable_objects": {
    "bindings": [{ "name": "ACCOUNTS", "class_name": "Account" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Account"] }]
}
